# ============================================================
# Copie este arquivo para .env e preencha com valores reais.
# NUNCA commite o .env de verdade.
# ============================================================

# Django
SECRET_KEY=troque-por-uma-chave-secreta-longa
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1

# AS/400 (DB2)
AS400_HOST=pub400.com
AS400_USER=seu_usuario
AS400_PASSWORD=sua_senha
AS400_LIBRARY=SUA_LIBRARY

# DeepSeek (chat IA)
DEEPSEEK_API_KEY=sua_chave_aqui

# Portfolio (menu_interface). Vazio = padrao por ambiente:
# dev http://<host>:8000/menu/ e producao https://arosasse.tec.br/
PORTFOLIO_URL=

# Banco de usuarios (Postgres do cnpj_interface) - fonte unica da senha.
# O role precisa de SELECT em auth_user. Sem USUARIOS_DB_NAME o login usa
# somente o espelho local (modo degradado).
USUARIOS_DB_NAME=
USUARIOS_DB_USER=
USUARIOS_DB_PASSWORD=
USUARIOS_DB_HOST=localhost
USUARIOS_DB_PORT=5432
